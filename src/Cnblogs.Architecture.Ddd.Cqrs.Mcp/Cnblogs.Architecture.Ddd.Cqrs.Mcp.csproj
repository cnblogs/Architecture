<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
Expose CQRS Commands and Queries as Model Context Protocol (MCP) tools over the Streamable HTTP transport, in the same delegate-first style as MapCommand/MapQuery. Tool calls dispatch in-process over MediatR's IMediator and run through the same validation/logging/cache/lock/enricher pipeline. Call MapMcp() to serve the tools; the endpoint coexists with MapCommand/MapQuery/MapAgent.
Commonly used types:
Cnblogs.Architecture.Ddd.Cqrs.Mcp.CqrsInjectorExtensions
Cnblogs.Architecture.Ddd.Cqrs.Mcp.CqrsMcpEndpointExtensions
Cnblogs.Architecture.Ddd.Cqrs.Mcp.CqrsMcpToolGroup
Cnblogs.Architecture.Ddd.Cqrs.Mcp.CqrsMcpToolCollection
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cnblogs.Architecture.Ddd.Cqrs.Abstractions\Cnblogs.Architecture.Ddd.Cqrs.Abstractions.csproj" />
    <ProjectReference Include="..\Cnblogs.Architecture.Ddd.Cqrs.DependencyInjection\Cnblogs.Architecture.Ddd.Cqrs.DependencyInjection.csproj" />
    <ProjectReference Include="..\Cnblogs.Architecture.Ddd.Infrastructure.Abstractions\Cnblogs.Architecture.Ddd.Infrastructure.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>

</Project>
